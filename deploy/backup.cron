# Ночной бэкап «Падачи». Ставится так:
#   sudo cp deploy/backup.cron /etc/cron.d/padacha-backup
#   sudo chmod 644 /etc/cron.d/padacha-backup
#
# База — каждую ночь, файлы — по воскресеньям (см. deploy/backup.sh).
# OFFSITE по умолчанию пуст: копии остаются на основном сервере.
# Указывать внешний сервер можно только после подтверждения владельца.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
OFFSITE=
OFFSITE_PORT=22

17 3 * * * root /opt/padacha-app/deploy/backup.sh >> /var/log/padacha-backup.log 2>&1

# Process fixed-operation requests from the hub; no Docker socket in the app.
* * * * * root python3 /opt/padacha-app/deploy/backup-worker.py >> /var/log/padacha-backup-worker.log 2>&1
