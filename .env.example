# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Часовой пояс заведения — от него зависят границы смены и выручка дня.
# Список: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
DJANGO_TIME_ZONE=Europe/Moscow
DJANGO_LANGUAGE_CODE=ru-ru

# PostgreSQL
POSTGRES_DB=humu
POSTGRES_USER=humu
POSTGRES_PASSWORD=humu
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# CORS (адрес фронта)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Платёжный провайдер (ЮKassa) — заполнить при подключении
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# LLM (OpenRouter) — распознавание чеков на складе. В dev можно оставить пустым:
# без ключа распознавание вернёт ошибку, остальной склад работает.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_RECEIPT_MODEL=google/gemini-2.5-flash
# Туннель на зарубежный сервер (OpenRouter недоступен из РФ). Только для LLM-трафика.
# Указывает на сервис `tunnel` внутри docker-сети (см. ниже TUNNEL_SSH_*).
# Оставь пустым, если тестируешь без распознавания чеков.
OPENAI_PROXY_URL=
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=humu

# SSH-туннель до зарубежного сервера (сервис `tunnel`, профиль tunnel).
# Ключ положить в deploy/tunnel/tunnel_key. Поднять: docker compose --profile tunnel up
# Тогда OPENAI_PROXY_URL=socks5://tunnel:1080
TUNNEL_SSH_HOST=
TUNNEL_SSH_USER=
TUNNEL_SSH_PORT=22

# Интернет-эквайринг. Какой банк — выбирается в админке (Настройки сайта →
# Приём оплаты), а доступы только здесь: /api/site/ отдаётся без авторизации,
# и секрету в базе не место. Заполняется тот блок, который выбран.
#
# Т-Банк (Т-Касса): ключ и пароль терминала из личного кабинета.
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
#
# Сбербанк (в т.ч. эквайринг, подключённый через Эвотор): логин и пароль
# API-пользователя (обычно вида имя-api). SBER_API_URL — только для тестового
# контура, в бою не задавать.
SBER_USERNAME=
SBER_PASSWORD=
SBER_API_URL=
#
# ЮKassa (сервис Сбера; ему же он отдаёт мелкий бизнес вместо прямого
# эквайринга): shopId и секретный ключ из личного кабинета. Чеки по
# 54-ФЗ в кабинете пока не включать — платёж без блока receipt банк
# отклонит, а мы его не отправляем.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Лицензия «Падачи». Ключ выдаёт пульт (padacha.ru/pult/) при подключении
# точки. Пусто — автономная установка: без сверки и блокировок, тариф
# правится в админке.
LICENSE_KEY=
LICENSE_URL=https://padacha.ru/api/license/
