# Шаблон продакшн-окружения. На сервере скопировать в .env и подставить свои значения.
# Секреты в репозиторий не коммитим — .env в .gitignore.

# Django
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=ЗАМЕНИТЬ_НА_СЛУЧАЙНУЮ_СТРОКУ
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=humuhumunukunukuapua.ru,www.humuhumunukunukuapua.ru,b5971f2535c5.vps.myjino.ru

# PostgreSQL (пароль придумать свой)
POSTGRES_DB=humu
POSTGRES_USER=humu
POSTGRES_PASSWORD=ЗАМЕНИТЬ_НА_СИЛЬНЫЙ_ПАРОЛЬ
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# SSL терминируется на стороне jino, до нас доходит http с заголовком X-Forwarded-Proto=https,
# поэтому внешние origin — https
CORS_ALLOWED_ORIGINS=https://humuhumunukunukuapua.ru
CSRF_TRUSTED_ORIGINS=https://humuhumunukunukuapua.ru,https://www.humuhumunukunukuapua.ru

# Платёжный провайдер — заполнить при подключении
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
