# Шаблон продакшн-окружения. На сервере скопировать в .env и подставить свои значения.
# Секреты в репозиторий не коммитим — .env в .gitignore.

# Django
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=ЗАМЕНИТЬ_НА_СЛУЧАЙНУЮ_СТРОКУ
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=humuhumunukunukuapua.ru,www.humuhumunukunukuapua.ru,b5971f2535c5.vps.myjino.ru

# PostgreSQL (пароль придумать свой)
POSTGRES_DB=humu
POSTGRES_USER=humu
POSTGRES_PASSWORD=ЗАМЕНИТЬ_НА_СИЛЬНЫЙ_ПАРОЛЬ
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# Зеркало pip для сборки образов (pypi.org недоступен с некоторых серверов РФ).
# Пусто → обычный pypi. Для jino: https://pypi.tuna.tsinghua.edu.cn/simple
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# SSL терминируется на стороне jino, до нас доходит http с заголовком X-Forwarded-Proto=https,
# поэтому внешние origin — https
CORS_ALLOWED_ORIGINS=https://humuhumunukunukuapua.ru
CSRF_TRUSTED_ORIGINS=https://humuhumunukunukuapua.ru,https://www.humuhumunukunukuapua.ru

# Интернет-эквайринг. Какой банк — выбирается в админке (Настройки сайта →
# Приём оплаты), а доступы только здесь: /api/site/ отдаётся без авторизации,
# и секрету в базе не место. Заполняется тот блок, который выбран.
#
# Т-Банк (Т-Касса): ключ и пароль терминала из личного кабинета.
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
#
# Сбербанк (в т.ч. эквайринг, подключённый через Эвотор): логин и пароль
# API-пользователя (обычно вида имя-api). SBER_API_URL — только для тестового
# контура, в бою не задавать.
SBER_USERNAME=
SBER_PASSWORD=
SBER_API_URL=

# LLM (OpenRouter) — распознавание чеков на складе
OPENAI_API_KEY=sk-or-v1-ЗАМЕНИТЬ
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_RECEIPT_MODEL=google/gemini-2.5-flash
# Прокси для LLM указывает на сервис `tunnel` внутри docker-сети.
OPENAI_PROXY_URL=socks5://tunnel:1080
OPENROUTER_SITE_URL=https://humuhumunukunukuapua.ru
OPENROUTER_APP_NAME=humu

# SSH-туннель до зарубежного сервера (сервис `tunnel`).
# Приватный ключ положить в deploy/tunnel/tunnel_key (не коммитить!).
# Поднять: docker compose -f docker-compose.prod.yml --profile tunnel up -d --build
TUNNEL_SSH_HOST=адрес-английского-сервера
TUNNEL_SSH_USER=пользователь
TUNNEL_SSH_PORT=22
